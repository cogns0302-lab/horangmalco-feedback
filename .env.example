# ── 필수 ─────────────────────────────────────────────────────────
# 관리자(본인) 계정. 서버 최초 실행 때 이 이메일/비밀번호로 관리자 계정이 만들어집니다.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=바꿔주세요-12자-이상

# 세션 서명 키(아무 긴 무작위 문자열). 비워 두면 data/secret.key 에 자동 생성됩니다.
SECRET_KEY=

# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ── 음성 인식(STT): 키를 넣은 것만 자동으로 사용, 2개 이상이면 교차 검증 ──────
# NAVER CLOVA Speech (네이버 클라우드 콘솔 > CLOVA Speech > 도메인의 Invoke URL / Secret Key)
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
# 리턴제로 VITO (https://developers.rtzr.ai)
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
# Groq (Whisper large-v3: 빠르고 저렴, 타임스탬프 제공. https://console.groq.com)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# OpenAI (whisper-1 = 타임스탬프 제공 / gpt-4o-transcribe = 정확도↑, 타임스탬프 없음)
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
# ElevenLabs Scribe
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# ── 선택 ─────────────────────────────────────────────────────────
# 피드백 작성 모델 / 추론 강도(low·medium·high·xhigh). 비용을 더 줄이려면 claude-sonnet-5-5
FEEDBACK_MODEL=claude-opus-5-5
FEEDBACK_EFFORT=high
# 문제 분석·STT 병합용 저비용 모델
MERGE_MODEL=claude-haiku-5-5
# 데이터 저장 위치(영속 디스크). 기본: ./data
# DATA_DIR=/data
# 학습 자료가 비어 있으면 서버 시작 때 드라이브에서 자동으로 받기
SYNC_ON_START=1
# 음성 추출 후 원본 영상 보관(1) / 삭제(0)
KEEP_VIDEO=0
MAX_UPLOAD_MB=4096
# 로컬에서 http 로 테스트할 때만 0
COOKIE_SECURE=1
